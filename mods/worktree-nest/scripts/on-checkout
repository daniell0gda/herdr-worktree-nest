#!/bin/sh

PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

is_null_ref() {
  [ -n "$1" ] || return 1
  rest=$1
  while [ -n "$rest" ]; do
    c=${rest%"${rest#?}"}
    rest=${rest#?}
    [ "$c" = "0" ] || return 1
  done
  return 0
}

previous_head=$1
flag=${3:-1}
is_null_ref "$previous_head" && [ "$flag" = "1" ] || exit 0

top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
[ "$common" != "$top/.git" ] || exit 0

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
"$script_dir/open-space" "$top" || true
exit 0
